#!/usr/bin/expect -f
set timeout 45
spawn ssh -o StrictHostKeyChecking=no user@192.168.31.14
expect "assword:"
send "12345\r"
expect "$ "
# Attempt SSH to the VM via host on forwarded port 22068
send "ssh -o StrictHostKeyChecking=no -p 22068 cloud-user@192.168.31.14\r"
expect {
    "assword:" {
        send "yyY5Gy0oP7xU\r"
        expect "$ "
        # Run dd direct write of 300MB
        send "dd if=/dev/zero of=test_load.img bs=1M count=300 oflag=direct\r"
        expect "$ "
        send "rm -f test_load.img\r"
        expect "$ "
        send "exit\r"
    }
    "Connection refused" {
        send_user "SSH connection refused on 22068\n"
        exit 1
    }
    timeout {
        send_user "SSH timeout on 22068\n"
        exit 2
    }
}
expect "$ "
send "exit\r"
expect eof
