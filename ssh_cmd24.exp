#!/usr/bin/expect -f
set timeout 15
spawn ssh -o StrictHostKeyChecking=no user@192.168.31.14
expect "assword:"
send "12345\r"
expect "$ "
send "sudo -S kubectl get vmi\r"
expect "assword:"
send "12345\r"
expect "$ "
send "sudo -S kubectl delete vmi --all\r"
expect "$ "
send "sudo -S kubectl delete vm --all\r"
expect "$ "
send "exit\r"
expect eof
