#!/usr/bin/expect -f
set timeout 15
spawn ssh -o StrictHostKeyChecking=no user@192.168.31.14
expect "assword:"
send "12345\r"
expect "$ "
send "sudo -S kubectl -n prometheus exec -it prometheus-prometheus-kube-prometheus-prometheus-0 -c prometheus -- curl -s http://localhost:9090/api/v1/targets\r"
expect "assword:"
send "12345\r"
expect "$ "
send "exit\r"
expect eof
