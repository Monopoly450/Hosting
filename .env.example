# ============================================================
# Конфигурация ByteBurners Hosting
#
# Обычно этот файл руками редактировать не нужно: install.sh спрашивает
# каждый пароль при установке (Enter — сгенерировать случайный) и пишет .env
# сам. Этот шаблон нужен только для ручной настройки — тогда скопируйте его в
# .env и ЗАМЕНИТЕ все значения CHANGE_ME.
# Сгенерировать надёжное значение: openssl rand -hex 24
#
# ВАЖНО: пароли ниже обязательны. Если какой-то не задан, docker compose
# откажется стартовать и назовёт недостающую переменную. Раньше вместо этого
# молча подставлялись значения по умолчанию (guest/guest, minioadmin и т.п.),
# опубликованные в этом репозитории, — то есть общеизвестные.
# ============================================================

# Настройки PostgreSQL (системная БД панели)
POSTGRES_DB=aegis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME__openssl_rand_hex_24

# Токен администратора для авторизации в API
ADMIN_TOKEN=CHANGE_ME__openssl_rand_hex_24

# Ключ шифрования секретов в БД (пароли внешних серверов, пароли пользовательских БД, ключи S3).
# ВАЖНО: после первого запуска ключ менять нельзя — старые секреты перестанут расшифровываться.
# Если не задан, ключ выводится из ADMIN_TOKEN (совместимость со старыми установками).
AEGIS_SECRET_KEY=CHANGE_ME__openssl_rand_hex_24

# Ссылки для подключения к базе данных для бэкенда и Go-оркестратора
# (пароль должен совпадать с POSTGRES_PASSWORD)
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME__openssl_rand_hex_24@127.0.0.1:5432/aegis
DB_CONN_STR=postgresql://postgres:CHANGE_ME__openssl_rand_hex_24@127.0.0.1:5432/aegis?sslmode=disable

# Учётные данные RabbitMQ (порт открыт только на 127.0.0.1)
RABBITMQ_USER=aegis
RABBITMQ_PASS=CHANGE_ME__openssl_rand_hex_24
RABBITMQ_URL=amqp://aegis:CHANGE_ME__openssl_rand_hex_24@localhost:5672/

# Корневая учётная запись MinIO (S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME__openssl_rand_hex_24

# Пароль root для служебного MariaDB
MARIADB_ROOT_PASSWORD=CHANGE_ME__openssl_rand_hex_24

# Класс хранения Kubernetes: local-path (один сервер) или nfs-storage (HA-кластер)
STORAGE_CLASS=local-path

# Внешний IP этого сервера — по нему пользователи обращаются к ВМ, приложениям
# маркетплейса, реестру образов и на него должны указывать A-записи доменов.
# Если не задать, IP определяется автоматически (по маршруту наружу). Задавайте
# явно, если сервер за NAT и «белый» адрес отличается от адреса интерфейса.
# AEGIS_HOST_IP=203.0.113.10

# Порт приватного реестра Docker-образов (контейнер aegis-registry)
REGISTRY_PORT=5000

# E-mail для Let's Encrypt: туда приходят уведомления об истечении сертификатов
# своих доменов. Необязателен, но настоятельно рекомендуется.
# ACME_EMAIL=admin@example.com

# Разрешённые CORS-источники панели. По умолчанию "*" (доступ по токену в
# заголовке, не по кукам). Для строгой изоляции укажите свои домены через запятую:
# AEGIS_CORS_ORIGINS=https://panel.example.com,https://vds.example.com
# AEGIS_CORS_ORIGINS=*

# Домены служебных сервисов этого хоста (не клиентских ВМ) — панель, почта
# (Roundcube) и консоль хранилища (MinIO). Каждый необязателен и независим от
# остальных. Если задан вместе с TIMEWEB_DNS_API_TOKEN, Caddy добавляет для
# него отдельный сайт и получает сертификат через DNS-01 у Timeweb — это
# работает даже когда A-запись домена указывает на приватный IP (обычный
# HTTP-01 ACME снаружи такой домен не проверит). Можно задать самим
# add-domain.sh (scripts/add-domain.sh) — правит только эти строки, ничего
# больше в .env не трогает.
# PANEL_DOMAIN=home.example.com
# MAIL_DOMAIN=mail.example.com
# STORAGE_DOMAIN=storage.example.com
# RABBITMQ_DOMAIN=queue.example.com
#
# Домена для PostgreSQL и MariaDB здесь нет намеренно: Caddy — реверс-прокси
# для HTTP, а СУБД общаются по своему бинарному протоколу поверх TCP. К ним
# подключаются по адресу и порту — реквизиты показывает «хаб подключения»
# на вкладке «Базы данных».

# API-токен DNS-провайдера с правом на управление записями. Нужен, только
# если задан хотя бы один из доменов выше. Достаточно ОДНОГО — того
# провайдера, у которого обслуживается зона; если заданы оба, используется
# Cloudflare.
#
# Токен делает две вещи:
#   1. Caddy подтверждает домен через DNS-01 и получает сертификат даже
#      когда сервер за NAT и снаружи недоступен.
#   2. Панель сама создаёт записи домена (TXT подтверждения и A на этот
#      сервер), когда вы добавляете домен во вкладке «Домены и TLS» —
#      руками в DNS лезть не нужно вовсе.
#
# Timeweb Cloud: Настройки → API-ключи
# TIMEWEB_DNS_API_TOKEN=
# Cloudflare: My Profile → API Tokens, права Zone:DNS:Edit для нужной зоны
# CLOUDFLARE_DNS_API_TOKEN=

# Cloudflare Tunnel — доступ к серверу из интернета без «белого» IP и без
# проброса портов на роутере: cloudflared сам подключается к Cloudflare, а
# Cloudflare принимает запросы к домену на себя. Это отдельная от
# сертификатов задача, и токен здесь тоже отдельный.
#
# Где взять: Cloudflare Zero Trust → Networks → Tunnels → создать туннель →
# Docker; в показанной команде нужна длинная строка после «--token».
# Публичные адреса задаются там же (Public hostnames) и указывают на
# http://localhost:8081 (панель), :8082 (почта), :9001 (хранилище),
# :15672 (очередь).
#
# COMPOSE_PROFILES обязателен: без него docker compose не поднимает
# контейнер туннеля вовсе (см. profiles у cloudflared в docker-compose.yml).
# CLOUDFLARE_TUNNEL_TOKEN=
# COMPOSE_PROFILES=cloudflare
